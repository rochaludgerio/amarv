<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="maui_amarv.Views.ConsultaPacientes"
    Title="Consulta de Pacientes"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray100}">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

        <!-- Título da página -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="CONSULTA DE PACIENTES"
                FontSize="23"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Pesquise e consulte os dados cadastrados."
                FontSize="14"
                TextColor="Gray"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Campo de pesquisa e botão -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="10">

            <SearchBar
                x:Name="searchPaciente"
                Placeholder="Digite o nome ou CPF do paciente"
                BackgroundColor="White"
                TextChanged="OnPesquisaTextoChanged"
                SearchButtonPressed="OnPesquisarClicked" />

            <Button
                Text="Pesquisar"
                Clicked="OnPesquisarClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="48" />

        </VerticalStackLayout>

        <!-- Lista de pacientes -->
        <CollectionView
            x:Name="listaPacientes"
            Grid.Row="2"
            SelectionMode="Single"
            SelectionChanged="OnPacienteSelecionado">

            <!-- Mensagem quando não houver pacientes -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="Nenhum paciente encontrado."
                        FontSize="16"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Verifique a pesquisa ou cadastre um paciente."
                        FontSize="13"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- Modelo visual de cada paciente -->
            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        Padding="15"
                        Margin="0,0,0,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="5">

                            <!-- Nome -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Nome}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="Black" />

                            <!-- CPF -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                FontSize="14"
                                TextColor="Gray" />

                            <!-- Idade -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{Binding IdadeAnos, StringFormat='Idade: {0} anos'}"
                                FontSize="14"
                                TextColor="Gray" />

                            <!-- Indicador de seleção -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.RowSpan="3"
                                Text="›"
                                FontSize="30"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Botão para voltar -->
        <Button
            Grid.Row="3"
            Text="Voltar ao Menu"
            Clicked="OnVoltarClicked"
            BackgroundColor="#666666"
            TextColor="White"
            CornerRadius="10"
            HeightRequest="48" />

    </Grid>

</ContentPage>