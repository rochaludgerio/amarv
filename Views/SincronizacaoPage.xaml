<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.SincronizacaoPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             VerticalOptions="Center">

            <Label Text="Sincronização e Backup"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="15"
                   BackgroundColor="White"
                   BorderColor="#DDDDDD">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Escolha uma opção:"
                           FontSize="18"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Sincronização e Backup"
                            Clicked="Button_Sincronizar_Clicked" />

                    <Button Text="Voltar ao Menu"
                            Clicked="Button_Menu_Clicked" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </Grid>

</ContentPage>