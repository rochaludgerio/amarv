<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.08"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <VerticalStackLayout Padding="30"
                             Spacing="18"
                             VerticalOptions="Center">

            <Label Text="Amar V"
                   FontSize="44"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Acesso ao Sistema"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Login:" />
                    <Entry x:Name="entry_login"
                           Placeholder="Digite seu login" />

                    <Label Text="Senha:" />
                    <Entry x:Name="entry_senha"
                           Placeholder="Digite sua senha"
                           IsPassword="True" />

                    <Button Text="Entrar"
                            Clicked="Button_Entrar_Clicked" />

                    <Label Text="Administrador: admin / 123&#10;Usuário: usuario / 123"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>

    </Grid>

</ContentPage>