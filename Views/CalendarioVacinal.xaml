<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.CalendarioVacinal"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <Label Text="Calendário Vacinal"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Calendário SUS"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="• BCG — dose única ao nascer" />
                    <Label Text="• Hepatite B — ao nascer" />
                    <Label Text="• VIP — 2, 4 e 6 meses" />
                    <Label Text="• Pentavalente — 2, 4 e 6 meses" />
                    <Label Text="• Rotavírus — 2 e 4 meses" />
                    <Label Text="• Pneumo 10 — 2, 4 meses e reforço" />
                    <Label Text="• Meningo C — 3 e 5 meses" />
                    <Label Text="• Covid baby — 6 e 7 meses" />
                    <Label Text="• Febre Amarela — 9 meses e reforços conforme indicação" />
                    <Label Text="• Meningo ACWY — 12 meses" />
                    <Label Text="• Tríplice Viral / SCR — 12 meses" />
                    <Label Text="• DTP — 15 meses e 4 anos" />
                    <Label Text="• Tetraviral — 15 meses" />
                    <Label Text="• Hepatite A — 15 meses" />
                    <Label Text="• Varicela — 4 anos" />
                    <Label Text="• Pneumo 23 — grupos indicados" />
                    <Label Text="• HPV — 9 a 14 anos" />
                    <Label Text="• Duplo Adulto — a partir dos 7 anos" />
                    <Label Text="• VOP — conforme esquema com VIP" />

                </VerticalStackLayout>
            </Frame>

            <Frame Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Calendário Privado"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="• Meningocócica B" />
                    <Label Text="• Hexavalente" />
                    <Label Text="• Pneumocócica 13" />
                    <Label Text="• Rotavírus Pentavalente" />
                    <Label Text="• Vacinas complementares conforme orientação profissional" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar"
                    Clicked="Button_Voltar_Clicked"
                    HorizontalOptions="Center" />

            <Button Text="Voltar ao Menu"
                    Clicked="Button_Menu_Clicked"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>