<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.MenuPrincipal"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.08"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <ScrollView>

            <VerticalStackLayout Padding="20"
                                 Spacing="15"
                                 VerticalOptions="CenterAndExpand">

                <Label Text="Amar V"
                       FontSize="42"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Menu Principal"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="lbl_usuario"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="Black" />

                <Frame Padding="20"
                       BackgroundColor="White"
                       BorderColor="#DDDDDD"
                       CornerRadius="10">

                    <VerticalStackLayout Spacing="12">

                        <!-- USUÁRIO DO SISTEMA -->


                        <Button
    x:Name="btn_cadastro_pessoa"
    Text="Cadastro de Pessoa"
    Clicked="Button_CadastroPessoa_Clicked" />


                        <Button x:Name="btn_cadastro"
                                Text="Cadastrar Paciente"
                                Clicked="Button_Cadastro_Clicked" />

                        <Button x:Name="btn_historico"
                                Text="Histórico Vacinal"
                                Clicked="Button_Historico_Clicked" />

                        <Button x:Name="btn_analise"
                                Text="Análise Vacinal"
                                Clicked="Button_Analise_Clicked" />

                        <Button x:Name="btn_consulta"
                                Text="Consultar Pacientes"
                                Clicked="Button_Consulta_Clicked" />

                        <Button x:Name="btn_calendario"
                                Text="Calendário Vacinal"
                                Clicked="Button_Calendario_Clicked" />

                        <Button x:Name="btn_relatorios"
                                Text="Relatórios"
                                Clicked="Button_Relatorios_Clicked" />

                        <Button x:Name="btn_sincronizacao"
                                Text="Sincronização Manual"
                                Clicked="Button_Sincronizacao_Clicked" />

                        <!-- ADMINISTRADOR -->

                        <Button x:Name="btn_vacinas"
                                Text="Vacinas e Doses"
                                Clicked="Button_Vacinas_Clicked" />

                        <Button x:Name="btn_atualizar_calendario"
                                Text="Atualizar Vacinas e Doses"
                                Clicked="Button_AtualizarCalendario_Clicked" />

                        <Button x:Name="btn_usuarios"
                                Text="Gerenciar Usuários"
                                Clicked="Button_Usuarios_Clicked" />

                        <Button x:Name="btn_backup"
                                Text="Backup"
                                Clicked="Button_Backup_Clicked" />

                        <!-- SAIR -->

                        <Button Text="Sair"
                                Clicked="Button_Sair_Clicked" />

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>