<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.ResumoPaciente"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <Label Text="Resumo do Paciente"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Paciente:"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Nome}" />

                    <Label Text="Idade:"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding IdadeFormatada}" />

                    <Label Text="Condição clínica:"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding CondicaoClinica}" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Ir para Análise Vacinal"
                    Clicked="Button_Analise_Clicked" />

            <Button Text="Voltar"
                    Clicked="Button_Voltar_Clicked"
                    HorizontalOptions="Center" />

            <Button Text="Voltar ao Menu"
                    Clicked="Button_Menu_Clicked"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>