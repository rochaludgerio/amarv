<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.HistoricoVacinalPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid Padding="20"
          RowDefinitions="Auto, Auto, *, Auto, Auto"
          RowSpacing="15">

        <Label Grid.Row="0"
               Text="Histórico Vacinal"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

        <Frame Grid.Row="1"
               Padding="15">
            <VerticalStackLayout Spacing="10">

                <Label Text="Paciente:" />
                <Picker x:Name="pck_paciente"
                        Title="Selecione o paciente"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedIndexChanged="pck_paciente_SelectedIndexChanged" />

                <Label x:Name="lbl_idade"
                       Text="Idade: -"
                       FontAttributes="Bold" />

                <Label Text="Informe quantas doses o paciente tomou das vacinas indicadas para a idade:" />

            </VerticalStackLayout>
        </Frame>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="layout_vacinas"
                                 Spacing="10" />
        </ScrollView>

        <Button Grid.Row="3"
                Text="Salvar Histórico Vacinal"
                Clicked="Button_Salvar_Clicked" />

        <Button Grid.Row="4"
                Text="Voltar ao Menu"
                Clicked="Button_Menu_Clicked"
                HorizontalOptions="Center" />

    </Grid>

</ContentPage>