<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.ConsultaVacinas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Grid Padding="20"
              RowDefinitions="Auto, Auto, *, Auto"
              RowSpacing="15">

            <Label Grid.Row="0"
                   Text="Vacinas e Doses"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Grid.Row="1"
                                   HorizontalOptions="Center"
                                   Spacing="10">

                <Button Text="SUS"
                        Clicked="Button_SUS_Clicked" />

                <Button Text="Privado"
                        Clicked="Button_Privado_Clicked" />

                <Button Text="Todos"
                        Clicked="Button_Todos_Clicked" />

            </HorizontalStackLayout>

            <CollectionView Grid.Row="2"
                            x:Name="collection_vacinas">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Margin="0,5"
                               Padding="12"
                               BackgroundColor="White"
                               BorderColor="#DDDDDD">

                            <VerticalStackLayout Spacing="5">

                                <Label Text="{Binding NomeVacina}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding Fabricante, StringFormat='Fabricante: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding TipoVacina, StringFormat='Tipo da vacina: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding TipoCalendario, StringFormat='Calendário: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding DosesNecessarias, StringFormat='Doses necessárias: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding IdadeMinimaMeses, StringFormat='Idade mínima: {0} meses'}"
                                       TextColor="Black" />

                                <Label Text="{Binding IdadeMaximaMeses, StringFormat='Idade máxima: {0} meses'}"
                                       TextColor="Black" />

                                <Label Text="{Binding IntervaloEntreDoses, StringFormat='Intervalo entre doses: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding ViaAdministracao, StringFormat='Via de administração: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding LocalAplicacao, StringFormat='Local de aplicação: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding Indicacao, StringFormat='Indicação: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding Contraindicacao, StringFormat='Contraindicação: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding EventosAdversos, StringFormat='Eventos adversos: {0}'}"
                                       TextColor="Black" />

                                <Label Text="{Binding Observacao, StringFormat='Observação: {0}'}"
                                       TextColor="Black" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button Grid.Row="3"
                    Text="Voltar ao Menu"
                    Clicked="Button_Menu_Clicked"
                    HorizontalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>