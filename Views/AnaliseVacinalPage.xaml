<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.AnaliseVacinalPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid Padding="20"
          RowDefinitions="Auto, Auto, *, Auto, Auto, Auto"
          RowSpacing="15">

        <Label Grid.Row="0"
               Text="Análise Vacinal"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

        <Frame Grid.Row="1"
               Padding="15">
            <VerticalStackLayout Spacing="10">

                <Label Text="Paciente:" />
                <Picker x:Name="pck_paciente"
                        Title="Selecione o paciente"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedIndexChanged="pck_paciente_SelectedIndexChanged" />

            </VerticalStackLayout>
        </Frame>

        <ScrollView Grid.Row="2">
            <Label x:Name="lbl_analise"
                   Text="Selecione um paciente para analisar."
                   TextColor="Black"
                   FontSize="16" />
        </ScrollView>

        <Button Grid.Row="3"
                Text="Compartilhar Análise"
                Clicked="Button_Compartilhar_Clicked" />

        <Button Grid.Row="4"
                Text="Imprimir Análise"
                Clicked="Button_Imprimir_Clicked" />

        <Button Grid.Row="5"
                Text="Voltar ao Menu"
                Clicked="Button_Menu_Clicked"
                HorizontalOptions="Center" />

    </Grid>

</ContentPage>