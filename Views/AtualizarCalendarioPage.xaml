<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          x:Class="maui_amarv.Views.AtualizarCalendarioPage"
          NavigationPage.HasNavigationBar="False"
          BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
           Opacity="0.06"
           Aspect="AspectFit"
           HorizontalOptions="Center"
           VerticalOptions="Center" />

        <Grid Padding="20"
          RowDefinitions="Auto, *, Auto"
          RowSpacing="15">

            <Label Grid.Row="0"
               Text="Atualizar Vacinas e Doses"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

            <ScrollView Grid.Row="1">

                <VerticalStackLayout Spacing="15">

                    <Frame Padding="15"
                       BackgroundColor="White"
                       BorderColor="#DDDDDD">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="Dados da vacina"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                            <Label Text="Nome da vacina:" TextColor="Black" />
                            <Entry x:Name="entry_nome"
                               Placeholder="Ex: Hepatite B"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Fabricante:" TextColor="Black" />
                            <Entry x:Name="entry_fabricante"
                               Placeholder="Ex: Conforme disponibilidade"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Tipo da vacina:" TextColor="Black" />
                            <Entry x:Name="entry_tipo_vacina"
                               Placeholder="Ex: Recombinante, vírus vivo, inativada"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Tipo de calendário:" TextColor="Black" />
                            <Picker x:Name="pck_tipo"
                                Title="Selecione"
                                TextColor="Black"
                                TitleColor="Gray"
                                BackgroundColor="White">
                                <Picker.Items>
                                    <x:String>SUS</x:String>
                                    <x:String>Privado</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Idade mínima em meses:" TextColor="Black" />
                            <Entry x:Name="entry_minima"
                               Placeholder="Ex: 0"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Idade máxima em meses:" TextColor="Black" />
                            <Entry x:Name="entry_maxima"
                               Placeholder="Ex: 9999"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Doses necessárias:" TextColor="Black" />
                            <Entry x:Name="entry_doses"
                               Placeholder="Ex: 3"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Intervalo entre doses:" TextColor="Black" />
                            <Entry x:Name="entry_intervalo"
                               Placeholder="Ex: 0, 1 e 6 meses"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Via de administração:" TextColor="Black" />
                            <Entry x:Name="entry_via"
                               Placeholder="Ex: Intramuscular"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Local de aplicação:" TextColor="Black" />
                            <Entry x:Name="entry_local"
                               Placeholder="Ex: Deltoide ou vasto lateral"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                            <Label Text="Indicação:" TextColor="Black" />
                            <Editor x:Name="editor_indicacao"
                                Placeholder="Informe a indicação da vacina"
                                AutoSize="TextChanges"
                                HeightRequest="80"
                                TextColor="Black"
                                PlaceholderColor="Gray"
                                BackgroundColor="White" />

                            <Label Text="Contraindicação:" TextColor="Black" />
                            <Editor x:Name="editor_contraindicacao"
                                Placeholder="Informe contraindicações"
                                AutoSize="TextChanges"
                                HeightRequest="80"
                                TextColor="Black"
                                PlaceholderColor="Gray"
                                BackgroundColor="White" />

                            <Label Text="Eventos adversos:" TextColor="Black" />
                            <Editor x:Name="editor_eventos"
                                Placeholder="Informe eventos adversos comuns"
                                AutoSize="TextChanges"
                                HeightRequest="80"
                                TextColor="Black"
                                PlaceholderColor="Gray"
                                BackgroundColor="White" />

                            <Label Text="Observação:" TextColor="Black" />
                            <Editor x:Name="editor_observacao"
                                Placeholder="Observações gerais"
                                AutoSize="TextChanges"
                                HeightRequest="80"
                                TextColor="Black"
                                PlaceholderColor="Gray"
                                BackgroundColor="White" />

                            <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="10">

                                <Button Text="Salvar"
                                    Clicked="Button_Salvar_Clicked" />

                                <Button Text="Editar"
                                    Clicked="Button_Editar_Clicked" />

                                <Button Text="Limpar"
                                    Clicked="Button_Limpar_Clicked" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                    <Label Text="Vacinas cadastradas"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />

                    <CollectionView x:Name="collection_regras"
                                SelectionMode="Single"
                                SelectionChanged="collection_regras_SelectionChanged">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Frame Padding="12"
                                   Margin="0,5"
                                   BackgroundColor="White"
                                   BorderColor="#DDDDDD">

                                    <VerticalStackLayout Spacing="5">

                                        <Label Text="{Binding NomeVacina}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />

                                        <Label Text="{Binding TipoCalendario, StringFormat='Calendário: {0}'}"
                                           TextColor="Black" />

                                        <Label Text="{Binding TotalDoses, StringFormat='Doses: {0}'}"
                                           TextColor="Black" />

                                        <Label Text="{Binding IdadeMinimaMeses, StringFormat='Idade mínima: {0} meses'}"
                                           TextColor="Black" />

                                        <Label Text="{Binding IdadeMaximaMeses, StringFormat='Idade máxima: {0} meses'}"
                                           TextColor="Black" />

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </ScrollView>

            <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               Spacing="10">

                <Button Text="Excluir"
                    Clicked="Button_Excluir_Clicked" />

                <Button Text="🔄 Recarregar Calendário 2026"
                    Clicked="Button_RecarregarCalendario_Clicked" />

                <Button Text="Voltar ao Menu"
                    Clicked="Button_Menu_Clicked" />

            </HorizontalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
