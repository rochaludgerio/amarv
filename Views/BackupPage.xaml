<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.BackupPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <Label Text="Backup"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Gerenciamento de Backup do Amar V"
                   FontSize="18"
                   TextColor="Black"
                   HorizontalTextAlignment="Center" />

            <!-- ================================================= -->
            <!-- USUÁRIO CONECTADO -->
            <!-- ================================================= -->

            <Frame BackgroundColor="White"
                   BorderColor="#DDDDDD"
                   Padding="15"
                   CornerRadius="10">

                <VerticalStackLayout Spacing="5">

                    <Label Text="Usuário conectado"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black" />

                    <Label x:Name="lbl_usuario"
                           FontSize="14"
                           TextColor="Black" />

                </VerticalStackLayout>

            </Frame>

            <!-- ================================================= -->
            <!-- GERENCIAMENTO -->
            <!-- ================================================= -->

            <Frame BackgroundColor="White"
                   BorderColor="#DDDDDD"
                   Padding="15"
                   CornerRadius="10">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Gerenciamento de Backup"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <Label Text="Utilize as opções abaixo para realizar uma cópia de segurança ou recuperar uma versão anterior do banco de dados."
                           FontSize="14"
                           TextColor="Black" />

                </VerticalStackLayout>

            </Frame>

            <!-- ================================================= -->
            <!-- REALIZAR BACKUP -->
            <!-- ================================================= -->

            <Button x:Name="btn_backup"
                    Text="Realizar Backup"
                    FontSize="16"
                    HeightRequest="50"
                    Clicked="Button_Backup_Clicked" />

            <!-- ================================================= -->
            <!-- RECUPERAR BACKUP -->
            <!-- ================================================= -->

            <Button x:Name="btn_recuperar"
                    Text="Recuperar Backup"
                    FontSize="16"
                    HeightRequest="50"
                    Clicked="Button_Recuperar_Clicked" />

            <!-- ================================================= -->
            <!-- STATUS -->
            <!-- ================================================= -->

            <Frame BackgroundColor="White"
                   BorderColor="#DDDDDD"
                   Padding="15"
                   CornerRadius="10">

                <VerticalStackLayout Spacing="5">

                    <Label Text="Status"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black" />

                    <Label x:Name="lbl_status"
                           Text="Nenhuma operação realizada."
                           FontSize="14"
                           TextColor="Black" />

                </VerticalStackLayout>

            </Frame>

            <!-- ================================================= -->
            <!-- VOLTAR -->
            <!-- ================================================= -->

            <Button Text="Voltar"
                    FontSize="16"
                    HeightRequest="50"
                    Clicked="Button_Menu_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>