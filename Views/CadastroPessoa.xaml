<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.CadastroPessoa"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid Padding="20"
          RowDefinitions="Auto,*"
          RowSpacing="15">

        <Label Grid.Row="0"
               Text="Cadastro de Pessoas"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <Frame Padding="15"
                       BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="12">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Selecionar pessoa cadastrada"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Picker x:Name="pck_pessoas"
                                Title="Selecione uma pessoa"
                                ItemDisplayBinding="{Binding Nome}"
                                SelectedIndexChanged="Pck_Pessoas_SelectedIndexChanged" />

                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="15"
                       BackgroundColor="White"
                       BorderColor="#E0E0E0"
                       CornerRadius="12">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Dados pessoais"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Label Text="Nome completo" />
                        <Entry x:Name="entry_nome"
                               Placeholder="Digite o nome completo"
                               MaxLength="255" />

                        <Label Text="Nome da mãe" />
                        <Entry x:Name="entry_nome_mae"
                               Placeholder="Digite o nome da mãe"
                               MaxLength="255" />

                        <Label Text="CPF" />
                        <Entry x:Name="entry_cpf"
                               Placeholder="Digite o CPF"
                               Keyboard="Numeric"
                               MaxLength="14" />

                        <Label Text="Telefone" />
                        <Entry x:Name="entry_telefone"
                               Placeholder="Digite o telefone"
                               Keyboard="Telephone"
                               MaxLength="20" />

                        <Label Text="Endereço" />
                        <Entry x:Name="entry_endereco"
                               Placeholder="Digite o endereço"
                               MaxLength="255" />

                    </VerticalStackLayout>
                </Frame>

                <Button x:Name="btn_salvar"
                        Text="Salvar Cadastro"
                        Clicked="Button_Salvar_Clicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button x:Name="btn_editar"
                        Text="Editar Cadastro"
                        Clicked="Button_Editar_Clicked"
                        BackgroundColor="#607D8B"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button x:Name="btn_excluir"
                        Text="Excluir Cadastro"
                        Clicked="Button_Excluir_Clicked"
                        BackgroundColor="#B3261E"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button Text="Voltar ao Menu"
                        Clicked="Button_Menu_Clicked"
                        BackgroundColor="#E0E0E0"
                        TextColor="Black"
                        CornerRadius="10"
                        HeightRequest="48" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
